{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnvArgs",
  "type": "object",
  "properties": {
    "name": {
      "description": "变量名（Windows 下不区分大小写）；不给出则列出全部",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "prefix": {
      "description": "变量名前缀过滤（Windows 下不区分大小写）",
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  }
}