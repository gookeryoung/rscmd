{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegexArgs",
  "type": "object",
  "properties": {
    "file": {
      "description": "从文件读取待匹配文本（与 TEXT 二选一）",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "pattern": {
      "description": "正则表达式（Rust regex 语法）",
      "type": "string"
    },
    "replace": {
      "description": "替换模板（支持 $1 / ${name}）；提供时额外输出替换后的文本",
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "size_limit": {
      "description": "自动机大小上限（字节），0 表示不限制",
      "type": "integer",
      "format": "uint",
      "default": 10485760,
      "minimum": 0
    },
    "text": {
      "description": "待匹配文本（与 --file 二选一）",
      "type": [
        "string",
        "null"
      ],
      "default": null
    }
  },
  "required": [
    "pattern"
  ]
}