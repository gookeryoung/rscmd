{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlobalArgs",
  "description": "CLI 全局参数（所有工具子命令共享）。",
  "type": "object",
  "properties": {
    "confirm": {
      "description": "确认执行有副作用的操作",
      "type": "boolean"
    },
    "dry_run": {
      "description": "仅预演，不产生副作用",
      "type": "boolean"
    },
    "json": {
      "description": "以 JSON 信封输出结果",
      "type": "boolean"
    },
    "limit": {
      "description": "结果条数上限，0 表示不限制",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "quiet": {
      "description": "人读模式下不输出成功结果",
      "type": "boolean"
    },
    "timeout": {
      "description": "单次调用的超时秒数，0 表示不限制；工具内的子进程与网络请求据此收敛",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "verbose": {
      "description": "在 stderr 输出工具名与耗时跟踪，不改变 stdout 契约",
      "type": "boolean"
    },
    "workers": {
      "description": "并行度，0 表示自动",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    }
  },
  "required": [
    "json",
    "quiet",
    "dry_run",
    "confirm",
    "workers",
    "limit",
    "verbose",
    "timeout"
  ]
}