"""`rscmd._native` 的类型声明。

实际模块由 maturin 在构建时编译产出（见 `crates/rscmd-py`），这里只声明
Python 侧可见的边界签名，供 mypy 检查 `rscmd` 包与测试代码。
"""

from typing import Any

class NativeError(Exception):
    """原生错误；`str(err)` 为 `rscmd-error/1` 的 JSON 字符串。"""

def version() -> str: ...
def tools() -> list[dict[str, Any]]: ...
def describe(name: str) -> dict[str, Any]: ...
def invoke(tool: str, args: dict[str, Any] | None = ...) -> Any: ...
def run_argv(argv: list[str]) -> dict[str, Any]: ...
def cli_main(argv: list[str]) -> tuple[int, str, str]: ...
